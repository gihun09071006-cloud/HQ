# ── App ─────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Database (PostgreSQL: Neon / Supabase / local) ──
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/offerhub

# ── Auth (NextAuth) ─────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
# generate: openssl rand -base64 32
NEXTAUTH_SECRET=change-me

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# SMTP for email magic links (optional)
EMAIL_SERVER=
EMAIL_FROM=

# Comma-separated emails auto-promoted to ADMIN on sign-in
ADMIN_EMAILS=you@example.com

# ── Cache (optional: Upstash Redis, free tier OK) ───
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Offer providers ─────────────────────────────────
# Dev sample data provider (turn off in production)
ENABLE_MOCK_PROVIDER=true
# AdGem publisher credentials
ADGEM_APP_ID=
ADGEM_API_KEY=
# S2S postback secret (AdGem dashboard → Postback). Verifies /api/postback/adgem
ADGEM_POSTBACK_SECRET=
# Exact postback URL registered in AdGem (scheme+host+path, no query).
# Needed for a correct HMAC preimage when behind a proxy/CDN. Optional locally.
ADGEM_POSTBACK_URL=

# ── HQ Credits (server-side conversion) ─────────────
# Credits are an INTERNAL, NON-MONETARY unit — never fiat, never a cash
# payout. The Credit Engine sizes grants from the provider payout (revenue):
#   credits = round(payoutUsd × HQ_PAYOUT_RATIO × HQ_CREDITS_PER_USD)
# This is provider-independent (works for AdGem/Torox/BitLabs/CPX alike).
# How many Credits equal $1 of payout basis. Default: 100.
HQ_CREDITS_PER_USD=100
# Internal share of revenue used to size Credit grants (0–1). NOT a cash
# payout ratio — just how generous Credit grants are. Default: 0.7.
HQ_PAYOUT_RATIO=0.7

# Salt for hashing click IPs (we store only the hash, never the raw IP).
# Falls back to NEXTAUTH_SECRET if unset.
IP_HASH_SALT=

# ── Cron protection ─────────────────────────────────
# generate: openssl rand -hex 24
CRON_SECRET=
