// ─────────────────────────────────────────────────────────────
// OfferHub — Prisma schema
// PostgreSQL. Every provider offer is normalized into `Offer`.
// ─────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ────────────────────────────────────────────────────

enum UserRole {
  USER
  ADMIN
}

enum OfferStatus {
  ACTIVE // live and visible
  DISABLED // manually disabled by admin (never auto-reactivated)
  HIDDEN // manually hidden by admin (never auto-reactivated)
  EXPIRED // no longer returned by the provider feed
}

enum DeviceType {
  ANDROID
  IOS
  WEB
  ALL
}

enum ProviderStatus {
  ACTIVE // synced on every run
  PAUSED // skipped by the sync engine
  ERROR // last sync failed (auto-set, auto-cleared on success)
}

// ── Auth (NextAuth) ──────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  walletAddress String?   @unique
  role          UserRole  @default(USER)
  credits       Int       @default(0) // HQ Credits balance (mirror of the ledger)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts     Account[]
  sessions     Session[]
  favorites    Favorite[]
  views        ViewHistory[]
  clicks       Click[]
  completions  OfferCompletion[]
  creditLedger CreditTransaction[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ── Offer domain ─────────────────────────────────────────────

model OfferProvider {
  id            String         @id @default(cuid())
  slug          String         @unique // "adgem", "torox", "bitlabs", ...
  name          String
  status        ProviderStatus @default(ACTIVE)
  lastSyncAt    DateTime?
  lastSyncCount Int?
  lastError     String?        @db.Text
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  offers Offer[]
}

model Category {
  id   String @id @default(cuid())
  slug String @unique // "game", "survey", "crypto", "finance", "app", ...
  name String

  offers Offer[]
}

model Country {
  code String @id // ISO 3166-1 alpha-2, uppercase ("US", "KR", ...)
  name String

  offers OfferCountry[]
}

/// The unified offer model. Every provider's payload is normalized
/// into this shape by its OfferProvider adapter.
model Offer {
  id         String @id @default(cuid())
  providerId String
  externalId String // provider-side offer id

  title        String
  description  String? @db.Text
  requirements String? @db.Text
  imageUrl     String?
  bannerUrl    String?
  url          String  @db.Text // affiliate/tracking url ({click_id}/{user_id} macros supported)

  rewardAmount   Decimal  @db.Decimal(12, 2) // user-facing reward value
  rewardCurrency String   @default("USD")
  payout         Decimal? @db.Decimal(12, 4) // publisher payout (our revenue), if exposed

  device           DeviceType  @default(ALL)
  categoryId       String?
  estimatedMinutes Int?
  approvalDays     Int?
  status           OfferStatus @default(ACTIVE)
  isFeatured       Boolean     @default(false)

  clickCount Int   @default(0) // lifetime clicks (fast sort key)
  trendScore Float @default(0) // clicks within the trending window (recomputed by sync)

  raw        Json? // original provider payload, kept for debugging/re-mapping
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  provider  OfferProvider  @relation(fields: [providerId], references: [id], onDelete: Cascade)
  category  Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  countries OfferCountry[]
  favorites   Favorite[]
  views       ViewHistory[]
  clicks      Click[]
  completions OfferCompletion[]

  @@unique([providerId, externalId])
  @@index([status, trendScore(sort: Desc)])
  @@index([status, rewardAmount(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@index([categoryId])
  @@index([providerId, lastSeenAt])
}

/// Join table: which countries an offer targets.
/// No rows ⇒ the offer is available globally.
model OfferCountry {
  offerId     String
  countryCode String

  offer   Offer   @relation(fields: [offerId], references: [id], onDelete: Cascade)
  country Country @relation(fields: [countryCode], references: [code], onDelete: Cascade)

  @@id([offerId, countryCode])
  @@index([countryCode])
}

// ── User engagement ──────────────────────────────────────────

model Favorite {
  userId    String
  offerId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  offer Offer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@id([userId, offerId])
  @@index([offerId])
}

model ViewHistory {
  id       String   @id @default(cuid())
  userId   String
  offerId  String
  viewedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  offer Offer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@index([userId, viewedAt(sort: Desc)])
  @@index([offerId])
}

/// Every outbound click through /go/[id]. This is the revenue event.
model Click {
  id        String   @id @default(cuid())
  offerId   String
  provider  String? // provider slug at click time
  userId    String?
  country   String? // from edge geo header when available
  device    String? // coarse UA classification
  ipHash    String? // salted SHA-256 of the client IP (never the raw IP)
  userAgent String?  @db.Text
  referer   String?
  createdAt DateTime @default(now())

  offer Offer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  user  User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([offerId, createdAt])
  @@index([createdAt])
  @@index([userId, createdAt])
}

// ── Conversions, credits & postbacks ─────────────────────────

/// A verified offer completion delivered by a provider S2S postback.
/// `(provider, transactionId)` is the idempotency key — the unique
/// constraint is what makes duplicate postbacks safe under retries and
/// concurrency. Provider economics (rewardAmount, payout) are stored for
/// reconciliation but never leave the server.
model OfferCompletion {
  id              String   @id @default(cuid())
  provider        String // "adgem", ...
  transactionId   String // provider-unique transaction id
  requestId       String? // provider request id, if sent
  playerId        String // provider-side player id (== our User.id)
  userId          String?
  offerId         String? // resolved Offer.id, when the offer is known
  externalOfferId String? // provider-side offer id
  offerName       String?
  goalId          String? // multi-goal / event offers
  goalName        String?
  campaignId      String?
  country         String?
  rewardAmount    Decimal? @db.Decimal(12, 2) // provider player reward — server-side only
  payout          Decimal? @db.Decimal(12, 4) // provider revenue (our payout) — server-side only
  credits         Int // HQ Credits granted for this completion
  status          String   @default("credited") // credited | ignored | reversed
  createdAt       DateTime @default(now())

  user  User?  @relation(fields: [userId], references: [id], onDelete: SetNull)
  offer Offer? @relation(fields: [offerId], references: [id], onDelete: SetNull)

  @@unique([provider, transactionId])
  @@index([userId, createdAt])
  @@index([offerId])
}

/// Append-only HQ Credits ledger. Every grant/adjustment is one row;
/// `balanceAfter` snapshots the resulting User.credits balance.
model CreditTransaction {
  id           String   @id @default(cuid())
  userId       String
  amount       Int // signed delta — grants are positive
  balanceAfter Int // User.credits after applying this row
  reason       String // "offer_completion", ...
  provider     String?
  completionId String? // OfferCompletion.id, when applicable
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/// Raw audit trail of every provider postback hit — verified or not.
/// Kept for debugging, dispute resolution and fraud review.
model PostbackLog {
  id            String   @id @default(cuid())
  provider      String
  transactionId String?
  playerId      String?
  rawQuery      String   @db.Text // full query string as received
  verified      Boolean  @default(false)
  status        String // ok | duplicate | invalid_verifier | unknown_player | bad_request | ...
  message       String?  @db.Text
  createdAt     DateTime @default(now())

  @@index([provider, createdAt])
  @@index([transactionId])
}
